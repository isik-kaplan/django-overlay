[sqlfluff]
dialect = postgres
templater = jinja
max_line_length = 120
exclude_rules = AM04

[sqlfluff:templater:jinja:context]
tenant_schema = public
view_name = person_view
base_table = person
function_name = person_view_instead_of_update
pk_column = "id"
pk_default_expr = nextval('"public"."person_id_seq"')
insert_columns = "id", "first_name", "age"
insert_values = NEW."id", NEW."first_name", NEW."age"
assignments = "first_name" = CASE WHEN NEW."first_name" IS DISTINCT FROM OLD."first_name" THEN NEW."first_name" ELSE "person"."first_name" END, "age" = CASE WHEN NEW."age" IS DISTINCT FROM OLD."age" THEN NEW."age" ELSE "person"."age" END
conflict_assignments = "first_name" = CASE WHEN NEW."first_name" IS DISTINCT FROM OLD."first_name" THEN EXCLUDED."first_name" ELSE "person"."first_name" END, "age" = CASE WHEN NEW."age" IS DISTINCT FROM OLD."age" THEN EXCLUDED."age" ELSE "person"."age" END
body = SELECT "id", "first_name", "age" FROM "public"."person"
trigger_name = overlayfk_note_person_id
referencing_table = note
column = person_id
column_ident = "person_id"
checks = EXISTS (SELECT 1 FROM "public"."person" WHERE "id" = NEW."person_id")
not_null = NEW."ssn" IS NOT NULL
exists_check = EXISTS (SELECT 1 FROM "public"."uniquetestsource" WHERE "ssn" = NEW."ssn" AND "id" != -NEW."id")
