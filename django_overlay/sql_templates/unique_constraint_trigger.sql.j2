CREATE OR REPLACE FUNCTION "{{ tenant_schema }}".{{ function_name }}() RETURNS TRIGGER AS $$
BEGIN
  IF {{ not_null }} AND {{ exists_check }} THEN
    -- %% is doubled: this string passes through psycopg's placeholder scanner
    -- even with no bound params. ERRCODE 23505 makes Django raise
    -- IntegrityError here, same as a real UNIQUE violation would.
    RAISE EXCEPTION 'overlay unique violation: a value in %% already exists in the source data',
      TG_TABLE_NAME
      USING ERRCODE = '23505';
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS {{ trigger_name }} ON "{{ tenant_schema }}"."{{ base_table }}";
CREATE CONSTRAINT TRIGGER {{ trigger_name }}
AFTER INSERT OR UPDATE ON "{{ tenant_schema }}"."{{ base_table }}"
DEFERRABLE INITIALLY DEFERRED
FOR EACH ROW EXECUTE FUNCTION "{{ tenant_schema }}".{{ function_name }}();
