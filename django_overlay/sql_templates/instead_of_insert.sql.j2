CREATE OR REPLACE FUNCTION "{{ tenant_schema }}".{{ function_name }}() RETURNS TRIGGER AS $$
BEGIN
  NEW.{{ pk_column }} := COALESCE(NEW.{{ pk_column }}, {{ pk_default_expr }});
  INSERT INTO "{{ tenant_schema }}"."{{ base_table }}" ({{ insert_columns }}) VALUES ({{ insert_values }});
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS {{ view_name }}_insert_trigger ON "{{ tenant_schema }}"."{{ view_name }}";
CREATE TRIGGER {{ view_name }}_insert_trigger
INSTEAD OF INSERT ON "{{ tenant_schema }}"."{{ view_name }}"
FOR EACH ROW EXECUTE FUNCTION "{{ tenant_schema }}".{{ function_name }}();
