{% macro select_list(id_expr) -%}
{%- for c in columns -%}
{%- if c == pk_column -%}{{ id_expr }} AS {{ pk_column | qi }}{%- else -%}{{ c | qi }}{%- endif -%}
{%- if not loop.last %}, {% endif -%}
{%- endfor -%}
{%- endmacro -%}
{#- Which branch a row came from, as a literal per branch rather than anything
    computed. That is the whole trick: a constant in the target list lets
    Postgres prove the other branch contributes nothing to `origin = '...'` and
    drop it -- Append node, anti-join and all -- so base_only() and
    source_only() cost less than querying the view at all.

    It has to stay a constant. A CASE that also told organic from overridden
    was measured: unreferenced it is free, because Postgres eliminates an
    unused target-list expression, but the moment you filter on it nothing can
    be proved and nothing is pruned. `origin = 'source'` then scanned every
    base row, hashed the whole source table to evaluate the CASE, discarded all
    of it and returned zero rows -- 17.4ms against 5.2ms for scanning the
    entire view. Those two populations are a semi-join in the queryset instead,
    paid by the callers who ask for them.

    Not in `columns`, which is model._meta.fields and drives both this select
    list and the INSERT list inside the INSTEAD OF triggers. Keeping it out
    means the triggers need no knowledge of it and Django, which names its
    columns explicitly, never selects it by accident.

    First rather than last, which is not cosmetic. CREATE OR REPLACE VIEW may
    only *append* columns -- rename one and Postgres refuses -- so with the
    origin at the end, every AddField migration inserts a model column in front
    of it and the replace fails with "cannot change name of view column". In
    front, model columns always append and every later migration replaces
    cleanly. Introducing the column into an existing project is still a drop
    and recreate, because it moves every column along by one. -#}
CREATE OR REPLACE VIEW {{ tenant_schema | qi }}.{{ view_name | qi }} AS
SELECT '{{ origin_base }}' AS {{ origin_column | qi }}, {{ select_list(pk_column | qi) }} FROM {{ tenant_schema | qi }}.{{ base_table | qi }}
{% if soft_delete -%}
WHERE NOT _overlay_deleted
{% endif -%}
{% if source -%}
UNION ALL
SELECT '{{ origin_source }}' AS {{ origin_column | qi }}, {{ select_list(("-" if source.negate else "") ~ (source.id_column | qi)) }} FROM {{ source.schema | qi }}.{{ source.table | qi }}
{#- NOT EXISTS, not NOT IN. Both express "the base table hasn't taken this id
    over", but NOT IN makes Postgres hash every base row before it can rule out
    a single source row -- a point lookup measured 39ms against 0.03ms once this
    became a real anti-join. The base pk is never NULL, so the two are
    equivalent here; NOT IN's NULL semantics were what the old IS NOT NULL
    filter was working around.

    The anti-join is skipped entirely when nothing can ever shadow a source
    row -- see OverlayMeta.overridable. It is the dominant cost of the whole
    view: the same two tables ordered by id measured 0.031ms as a bare UNION
    ALL (Merge Append, which LIMIT stops early) against 53ms with the anti-join
    above them. A non-overridable model that also hard-deletes has nothing in
    its base table that can collide with a source id, so there is nothing to
    exclude. With soft delete a tombstone still shadows, but only a tombstone,
    so the check narrows to those -- which is a far smaller and better
    estimated relation than the whole base table. -#}
{% if anti_join or source.extra_where -%}
WHERE {% if source.extra_where %}{{ source.extra_where }}{% if anti_join %} AND {% endif %}{% endif -%}
{% if anti_join -%}
NOT EXISTS (SELECT 1 FROM {{ tenant_schema | qi }}.{{ base_table | qi }} AS overlay_base WHERE overlay_base.{{ pk_column | qi }} = {{ "-" if source.negate }}{{ source.table | qi }}.{{ source.id_column | qi }}{% if anti_join == "tombstones" %} AND overlay_base._overlay_deleted{% endif %})
{% endif -%}
{% endif -%}
{% endif -%}
;
