CREATE OR REPLACE FUNCTION "{{ tenant_schema }}".{{ function_name }}() RETURNS TRIGGER AS $$
BEGIN
  -- Hard delete. Swap for a re-materialize-from-source step if deletes
  -- should instead revert to showing the untouched source row.
  DELETE FROM "{{ tenant_schema }}"."{{ base_table }}" WHERE {{ pk_column }} = OLD.{{ pk_column }};
  RETURN OLD;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS {{ view_name }}_delete_trigger ON "{{ tenant_schema }}"."{{ view_name }}";
CREATE TRIGGER {{ view_name }}_delete_trigger
INSTEAD OF DELETE ON "{{ tenant_schema }}"."{{ view_name }}"
FOR EACH ROW EXECUTE FUNCTION "{{ tenant_schema }}".{{ function_name }}();
