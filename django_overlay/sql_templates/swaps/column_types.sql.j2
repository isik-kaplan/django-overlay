{#- {column: rendered type} for one relation. format_type() rather than
    information_schema, because it renders the modifier too: varchar(100) and
    varchar(200) are the same udt_name and a different thing to select into a
    CharField(max_length=100). -#}
SELECT a.attname, format_type(a.atttypid, a.atttypmod)
FROM pg_attribute a
JOIN pg_class c ON c.oid = a.attrelid
JOIN pg_namespace n ON n.oid = c.relnamespace
WHERE n.nspname = %s
  AND c.relname = %s
  AND a.attnum > 0
  AND NOT a.attisdropped
