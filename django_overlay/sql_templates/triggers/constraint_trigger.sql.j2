CREATE OR REPLACE FUNCTION {{ tenant_schema | qi }}.{{ function_name | qi }}() RETURNS TRIGGER AS $$
BEGIN
  -- Deferred to COMMIT, so by the time this runs NEW is how the row looked
  -- when the event was queued, not necessarily how it looks now. Postgres
  -- doesn't drop queued events for rows deleted later in the same
  -- transaction (its own referential-integrity triggers get that skip
  -- internally; a user-written constraint trigger doesn't), so without this
  -- guard `create(); delete()` inside one transaction fails at COMMIT
  -- against a parent that is legitimately gone. A column changed since is
  -- the same story — that UPDATE queued its own event, which checks the
  -- value that actually landed.
  IF NOT EXISTS (
    SELECT 1 FROM {{ tenant_schema | qi }}.{{ referencing_table | qi }}
    WHERE {{ referencing_pk | qi }} = NEW.{{ referencing_pk | qi }}
      AND {{ column | qi }} IS NOT DISTINCT FROM NEW.{{ column | qi }}
  ) THEN
    RETURN NULL;
  END IF;

  -- Only re-check on UPDATE if this column actually changed.
  IF (TG_OP = 'INSERT' OR NEW.{{ column | qi }} IS DISTINCT FROM OLD.{{ column | qi }})
     AND NEW.{{ column | qi }} IS NOT NULL
     AND NOT (
       {% for t in target_tables -%}
       EXISTS (SELECT 1 FROM {{ t.schema | qi }}.{{ t.table | qi }} WHERE {{ t.id_column | qi }} = {{ "-" if t.negate }}NEW.{{ column | qi }}{% if t.soft_delete %} AND NOT _overlay_deleted{% endif %}{% if t.masked_by %} AND NOT EXISTS (SELECT 1 FROM {{ t.masked_by.schema | qi }}.{{ t.masked_by.table | qi }} WHERE {{ t.masked_by.table | qi }}.{{ t.masked_by.id_column | qi }} = NEW.{{ column | qi }} AND {{ t.masked_by.table | qi }}._overlay_deleted){% endif %})
       {%- if not loop.last %} OR {% endif %}
       {% endfor -%}
     )
  THEN
    -- %% doubled so psycopg doesn't treat it as a bind placeholder.
    RAISE EXCEPTION 'overlay FK violation: %%.%% = %% not found in any target table',
      TG_TABLE_NAME, '{{ column }}', NEW.{{ column | qi }}
      USING ERRCODE = '23503';
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS {{ trigger_name | qi }} ON {{ tenant_schema | qi }}.{{ referencing_table | qi }};
CREATE CONSTRAINT TRIGGER {{ trigger_name | qi }}
AFTER INSERT OR UPDATE ON {{ tenant_schema | qi }}.{{ referencing_table | qi }}
DEFERRABLE INITIALLY DEFERRED
FOR EACH ROW EXECUTE FUNCTION {{ tenant_schema | qi }}.{{ function_name | qi }}();
