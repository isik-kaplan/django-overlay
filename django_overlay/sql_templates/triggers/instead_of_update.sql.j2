{% macro merge(proposed_prefix) -%}
{%- for c in columns | reject("equalto", pk_column) | list -%}
{{ c | qi }} = CASE WHEN NEW.{{ c | qi }} IS DISTINCT FROM OLD.{{ c | qi }} THEN {{ proposed_prefix }}.{{ c | qi }} ELSE {{ base_table | qi }}.{{ c | qi }} END
{%- if not loop.last %}, {% endif -%}
{%- endfor -%}
{%- endmacro -%}
CREATE OR REPLACE FUNCTION {{ tenant_schema | qi }}.{{ function_name | qi }}() RETURNS TRIGGER AS $$
BEGIN
  -- Only overwrite a column if this UPDATE actually changed it, so a
  -- concurrent write to a different column doesn't get clobbered. The
  -- base_table qualifier is required: bare `col` is ambiguous once
  -- EXCLUDED is in scope below.
  UPDATE {{ tenant_schema | qi }}.{{ base_table | qi }} SET {{ merge("NEW") }} WHERE {{ pk_column | qi }} = OLD.{{ pk_column | qi }};
  IF NOT FOUND THEN
{%- if overridable %}
    -- Copy-up in two statements, not one: materialise the row exactly as the
    -- view presented it, then apply the edit on top. OLD is that row -- the
    -- source values, with the id already negated for a source-derived row --
    -- so the pair lands on the same base row a single INSERT of NEW would
    -- have, and the tests below pin that.
    --
    -- The reason to spend the extra statement is that it makes the write
    -- legible to anything watching the base table. A row-level AFTER trigger
    -- (django-pghistory, or your own audit table) sees a materialise carrying
    -- the source's own values, then a change touching only the columns the
    -- caller actually edited. Collapsed into one INSERT, the first edit of a
    -- row reports every column as written and there is no way to tell an
    -- override from a value that merely came across with it -- which is the
    -- question "has this tenant touched this field" needs answered, and the
    -- one a refresh-from-source has to ask before overwriting anything.
    --
    -- It also makes this path agree with the bulk one.
    -- OverlayQuerySet._copy_matched_rows_to_the_base_table() has always
    -- materialised with a separate INSERT ... SELECT before its UPDATE, so a
    -- queryset update and a save() of the same edit used to leave different
    -- shapes behind. Now they leave the same two.
    --
    -- Only the first edit of a row pays it; once the base row exists the
    -- UPDATE above matches and neither statement here runs.
    --
    -- DO NOTHING rather than DO UPDATE, and the merge moved below it. The
    -- conflict case is a concurrent session materialising the same row between
    -- our UPDATE finding nothing and this INSERT; their row is as good as
    -- ours, so keep it and let the merge apply our columns on top. DO UPDATE
    -- with the whole of EXCLUDED would have overwritten theirs wholesale.
    INSERT INTO {{ tenant_schema | qi }}.{{ base_table | qi }} (
      {%- for c in columns -%}{{ c | qi }}{% if not loop.last %}, {% endif %}{%- endfor -%}{% if soft_delete %}, _overlay_deleted{% endif %}
    )
    VALUES (
      {%- for c in columns -%}OLD.{{ c | qi }}{% if not loop.last %}, {% endif %}{%- endfor -%}{% if soft_delete %}, FALSE{% endif %}
    )
    ON CONFLICT ({{ pk_column | qi }}) DO NOTHING;
    UPDATE {{ tenant_schema | qi }}.{{ base_table | qi }} SET {{ merge("NEW") }} WHERE {{ pk_column | qi }} = OLD.{{ pk_column | qi }};
{%- else %}
    -- No base row matched, so this row is source-backed and updating it would
    -- mean materialising it. The model is declared overridable = False, and
    -- the view above drops (or narrows) its anti-join on the strength of that,
    -- so letting the copy happen would put the same id in both branches and
    -- silently return it twice. Raise instead -- the invariant is enforced
    -- here rather than assumed, so raw SQL cannot break it either.
    --
    -- 0A000 is feature_not_supported, which Django surfaces as
    -- NotSupportedError rather than a bare DatabaseError.
    RAISE EXCEPTION 'overlay: {{ view_name }} is declared overridable = False, so its source-backed rows cannot be modified'
      USING ERRCODE = '0A000',
            HINT = 'Insert your own row instead, or drop overridable = False from the model''s OverlayMeta.';
{%- endif %}
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS {{ (view_name ~ "_update_trigger") | qi }} ON {{ tenant_schema | qi }}.{{ view_name | qi }};
CREATE TRIGGER {{ (view_name ~ "_update_trigger") | qi }}
INSTEAD OF UPDATE ON {{ tenant_schema | qi }}.{{ view_name | qi }}
FOR EACH ROW EXECUTE FUNCTION {{ tenant_schema | qi }}.{{ function_name | qi }}();
