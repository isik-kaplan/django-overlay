CREATE OR REPLACE FUNCTION {{ tenant_schema | qi }}.{{ function_name }}() RETURNS TRIGGER AS $$
BEGIN
  -- Soft delete: flag the row instead of removing it, so a source-backed
  -- row stays masked forever instead of reappearing once its base copy is gone.
  UPDATE {{ tenant_schema | qi }}.{{ base_table | qi }} SET _overlay_deleted = TRUE WHERE {{ pk_column | qi }} = OLD.{{ pk_column | qi }};
  IF NOT FOUND THEN
    INSERT INTO {{ tenant_schema | qi }}.{{ base_table | qi }} (
      {%- for c in columns -%}{{ c | qi }}, {% endfor -%}_overlay_deleted
    ) VALUES (
      {%- for c in columns -%}OLD.{{ c | qi }}, {% endfor -%}TRUE
    )
    ON CONFLICT ({{ pk_column | qi }}) DO UPDATE SET _overlay_deleted = TRUE;
  END IF;
  RETURN OLD;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS {{ view_name }}_delete_trigger ON {{ tenant_schema | qi }}.{{ view_name | qi }};
CREATE TRIGGER {{ view_name }}_delete_trigger
INSTEAD OF DELETE ON {{ tenant_schema | qi }}.{{ view_name | qi }}
FOR EACH ROW EXECUTE FUNCTION {{ tenant_schema | qi }}.{{ function_name }}();
