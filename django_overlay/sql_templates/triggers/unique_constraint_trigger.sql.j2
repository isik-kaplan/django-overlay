CREATE OR REPLACE FUNCTION {{ tenant_schema | qi }}.{{ function_name | qi }}() RETURNS TRIGGER AS $$
BEGIN
  -- Only re-check on UPDATE if a constrained column actually changed.
  -- A condition's columns count too: reopening a row can make it collide.
  IF (TG_OP = 'INSERT' OR (
        {% for c in watched_columns -%}
        NEW.{{ c | qi }} IS DISTINCT FROM OLD.{{ c | qi }}{% if not loop.last %} OR {% endif %}
        {%- endfor %}
      ))
     AND (
       {% for c in columns -%}
       NEW.{{ c | qi }} IS NOT NULL{% if not loop.last %} AND {% endif %}
       {%- endfor %}
     )
     {%- if condition %}
     -- A row outside the condition reserves nothing and is never refused. The
     -- condition names only the model's own columns, unqualified, so it reads
     -- this one-row derived table here and the source row below.
     AND EXISTS (SELECT 1 FROM (SELECT NEW.*) AS overlay_new WHERE {{ condition }})
     {%- endif %}
     -- Exclude this row's own source origin, or it'd conflict with itself.
     AND EXISTS (
       SELECT 1 FROM {{ source.schema | qi }}.{{ source.table | qi }} AS src
       WHERE (
         {% for c in columns -%}
         src.{{ c | qi }} = NEW.{{ c | qi }}{% if not loop.last %} AND {% endif %}
         {%- endfor %}
       )
       AND src.{{ source.id_column | qi }} != {{ "-" if negate }}NEW.{{ pk_column | qi }}
       {%- if source.extra_where %}
       -- A source row the view leaves out is not a row of the model, so its
       -- value reserves nothing.
       AND ({{ source.extra_where }})
       {%- endif %}
       {%- if condition %}
       AND ({{ condition }})
       {%- endif %}
       {%- if anti_join %}
       -- A source row the base table shadows isn't a visible row, so its value
       -- reserves nothing: the view shows the base row instead, which the
       -- partial unique index already covers. The same anti-join as the view's
       -- (see sql.anti_join_kind): with overrides, any base row shadows its
       -- source row; without them only a tombstone can.
       AND NOT EXISTS (
         SELECT 1 FROM {{ tenant_schema | qi }}.{{ base_table | qi }} AS shadow
         WHERE shadow.{{ pk_column | qi }} = {{ "-" if negate }}src.{{ source.id_column | qi }}
           {%- if anti_join == "tombstones" %}
           AND shadow._overlay_deleted
           {%- endif %}
       )
       {%- endif %}
     )
  THEN
    -- %% doubled so psycopg doesn't treat it as a bind placeholder.
    RAISE EXCEPTION 'overlay unique violation: a value in %% already exists in the source data',
      TG_TABLE_NAME
      USING ERRCODE = '23505';
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS {{ trigger_name | qi }} ON {{ tenant_schema | qi }}.{{ base_table | qi }};
CREATE CONSTRAINT TRIGGER {{ trigger_name | qi }}
AFTER INSERT OR UPDATE ON {{ tenant_schema | qi }}.{{ base_table | qi }}
-- INITIALLY IMMEDIATE, unlike the FK trigger, to match what Postgres does for
-- the native half of this constraint: a unique index raises at the statement.
-- Deferring only the source-side half would mean the same constraint failing
-- at two different moments depending on which side you collided with. Still
-- DEFERRABLE, so SET CONSTRAINTS can opt into deferral where it is wanted.
DEFERRABLE INITIALLY IMMEDIATE
FOR EACH ROW EXECUTE FUNCTION {{ tenant_schema | qi }}.{{ function_name | qi }}();
