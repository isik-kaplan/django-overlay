CREATE OR REPLACE FUNCTION "{{ tenant_schema }}".{{ function_name }}() RETURNS TRIGGER AS $$
BEGIN
  UPDATE "{{ tenant_schema }}"."{{ base_table }}" SET {{ assignments }} WHERE {{ pk_column }} = OLD.{{ pk_column }};
  IF NOT FOUND THEN
    -- NEW is already the fully-resolved post-update row, so this INSERT is a
    -- complete copy-up-with-override in one step, no separate fetch needed.
    INSERT INTO "{{ tenant_schema }}"."{{ base_table }}" ({{ insert_columns }})
    VALUES ({{ insert_values }})
    ON CONFLICT ({{ pk_column }}) DO UPDATE SET {{ conflict_assignments }};
  END IF;
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;

DROP TRIGGER IF EXISTS {{ view_name }}_update_trigger ON "{{ tenant_schema }}"."{{ view_name }}";
CREATE TRIGGER {{ view_name }}_update_trigger
INSTEAD OF UPDATE ON "{{ tenant_schema }}"."{{ view_name }}"
FOR EACH ROW EXECUTE FUNCTION "{{ tenant_schema }}".{{ function_name }}();
